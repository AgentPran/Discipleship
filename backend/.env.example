# Database (SQLite — zero install, single file in backend/)
DATABASE_URL=sqlite:///./discipleship.db

# To use Postgres later instead, comment out the line above and use:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/discipleship

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
FRONTEND_URL=http://localhost:5173
